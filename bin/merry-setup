#!/usr/bin/env bash
set -euo pipefail

if [[ ${DEBUG:-0} == 1 ]]; then
  set -x
fi

readonly MINIMUM_DART_RUNTIME=3.12.0
readonly DART_RELEASE_BASE_URL=https://storage.googleapis.com/dart-archive/channels/stable/release
readonly FLUTTER_RELEASES_URL=https://storage.googleapis.com/flutter_infra_release/releases/releases_linux.json
readonly FLUTTER_RELEASE_BASE_URL=https://storage.googleapis.com/flutter_infra_release/releases
readonly TRUNK_LAUNCHER_URL=https://trunk.io/releases/trunk
readonly BASHRC_BLOCK_BEGIN='# >>> merry-setup managed block >>>'
readonly BASHRC_BLOCK_END='# <<< merry-setup managed block <<<'

ACTIVE_FAMILY_ROOT=""
ACTIVE_METADATA_FILE=""
ACTIVE_STAGE_DIR=""
ACTIVE_TRUNK_STAGE=""
ACTIVE_BASHRC_TEMP=""
LOCAL_TOOL_BIN=""
TRUNK_LAUNCHER=""
RESOLVED_SDK_VERSION=""
RESOLVED_DART_VERSION=""
RESOLVED_DART_ARCH=""
RESOLVED_ARCHIVE_URL=""
RESOLVED_ARCHIVE_SHA256=""
CURRENT_SDK_ROOT=""
HOST_ARCHITECTURE=""
FLUTTERFIRE_BUNDLE_ENABLED=false
PRECACHE_ANDROID=false
PRECACHE_WEB=false
PRECACHE_LINUX=false
NPM_EXECUTABLE=""
NPM_GLOBAL_BIN=""
declare -a ACTIVATION_PACKAGE_NAMES=()
declare -a ACTIVATION_PACKAGE_CONSTRAINTS=()
declare -A ACTIVATION_PACKAGE_INDEX=()

die() {
  printf 'ERROR: %s\n' "$*" >&2
  exit 1
}

usage() {
  printf '%s\n' \
    'Usage:' \
    '  merry-setup setup --sdk dart|flutter --bootstrap STRATEGY --persist-path ADAPTER [options]' \
    '  merry-setup bootstrap --sdk dart|flutter --bootstrap STRATEGY --persist-path ADAPTER [options]' \
    '' \
    'STRATEGY: none | dart | flutter | melos | very-good' \
    'ADAPTER:  none | bashrc | github' \
    '' \
    'Options:' \
    '  --sdk-version stable|<exact>       SDK version (default: stable)' \
    '  --project-dir <path>               project root containing pubspec.yaml (default: current directory)' \
    '  --no-merry                         skip the default merry activation' \
    '  --merry-version <constraint>       pub constraint for merry' \
    '  --dart-package <name>[=<constraint>]  additional global package (repeatable)' \
    '  --bundle flutterfire               activate flutterfire_cli and install firebase-tools (repeatable)' \
    '  --firebase-tools-version <exact>   exact firebase-tools version for the flutterfire bundle' \
    '  --precache <targets>               comma-separated android, web, linux (repeatable; flutter only)' \
    '  --trunk-path <path>                explicit Trunk launcher' \
    '' \
    'Environment: MERRY_SETUP_HOME (default ~/.merry-setup), PUB_CACHE (override), DEBUG=1 (trace)'
}

require_option_value() {
  local option_name="$1"
  local remaining_count="$2"
  local candidate_value="${3-}"

  if ((remaining_count < 2)) || [[ ${candidate_value} == --* ]]; then
    die "Option '${option_name}' requires a value."
  fi
}

validate_absolute_path() {
  local contract_name="$1"
  local contract_value="$2"

  if [[ -z ${contract_value} || ${contract_value} != /* || ${contract_value} == *:* || ${contract_value} =~ [[:cntrl:]] ]]; then
    die "${contract_name} must be a nonempty absolute path."
  fi
}

validate_host() {
  local host_os
  local host_arch

  host_os="$(uname -s)"
  host_arch="$(uname -m)"

  [[ ${host_os} == Linux ]] || die "Unsupported operating system: ${host_os}. The initial release supports Linux x64 only."
  [[ ${host_arch} == x86_64 ]] || die "Unsupported architecture: ${host_arch}. The initial release supports Linux x64 only."
  HOST_ARCHITECTURE="${host_arch}"
}

cleanup_sdk_transients() {
  if [[ -n ${ACTIVE_METADATA_FILE} && -n ${ACTIVE_FAMILY_ROOT} && ${ACTIVE_METADATA_FILE} == "${ACTIVE_FAMILY_ROOT}/.metadata."* ]]; then
    rm -f -- "${ACTIVE_METADATA_FILE}"
  fi

  if [[ -n ${ACTIVE_STAGE_DIR} && -n ${ACTIVE_FAMILY_ROOT} && ${ACTIVE_STAGE_DIR} == "${ACTIVE_FAMILY_ROOT}/."*.staging.* ]]; then
    rm -rf -- "${ACTIVE_STAGE_DIR}"
  fi

  if [[ -n ${ACTIVE_TRUNK_STAGE} && -n ${LOCAL_TOOL_BIN} && ${ACTIVE_TRUNK_STAGE} == "${LOCAL_TOOL_BIN}/.trunk."* ]]; then
    rm -f -- "${ACTIVE_TRUNK_STAGE}"
  fi

  if [[ -n ${ACTIVE_BASHRC_TEMP} && ${ACTIVE_BASHRC_TEMP} == *"/.bashrc.merry-setup."* ]]; then
    rm -f -- "${ACTIVE_BASHRC_TEMP}"
  fi
}

trap cleanup_sdk_transients EXIT

is_exact_semver() {
  local version_value="$1"
  local version_pattern='^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$'

  [[ ${version_value} =~ ${version_pattern} ]]
}

extract_first_semver() {
  local source_value="$1"
  local version_pattern='(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)'

  if [[ ${source_value} =~ ${version_pattern} ]]; then
    printf '%s.%s.%s\n' "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" "${BASH_REMATCH[3]}"
    return 0
  fi

  return 1
}

extract_first_reported_version() {
  local source_value="$1"
  local version_pattern='(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(-([0-9A-Za-z-]+(\.[0-9A-Za-z-]+)*))?(\+([0-9A-Za-z-]+(\.[0-9A-Za-z-]+)*))?'

  if [[ ${source_value} =~ ${version_pattern} ]]; then
    printf '%s\n' "${BASH_REMATCH[0]}"
    return 0
  fi

  return 1
}

version_is_at_least() {
  local candidate_version="$1"
  local minimum_version="$2"
  local candidate_major=0
  local candidate_minor=0
  local candidate_patch=0
  local minimum_major=0
  local minimum_minor=0
  local minimum_patch=0

  is_exact_semver "${candidate_version}" || return 1
  is_exact_semver "${minimum_version}" || return 1

  IFS=. read -r candidate_major candidate_minor candidate_patch <<<"${candidate_version}"
  IFS=. read -r minimum_major minimum_minor minimum_patch <<<"${minimum_version}"

  ((10#${candidate_major} > 10#${minimum_major})) && return 0
  ((10#${candidate_major} < 10#${minimum_major})) && return 1
  ((10#${candidate_minor} > 10#${minimum_minor})) && return 0
  ((10#${candidate_minor} < 10#${minimum_minor})) && return 1
  ((10#${candidate_patch} >= 10#${minimum_patch}))
}

require_minimum_dart_runtime() {
  local dart_version="$1"

  version_is_at_least "${dart_version}" "${MINIMUM_DART_RUNTIME}" || die "Effective Dart runtime ${dart_version} is below the minimum ${MINIMUM_DART_RUNTIME}."
}

download_file() {
  local source_url="$1"
  local destination_file="$2"
  local description="$3"

  command -v curl >/dev/null 2>&1 || die "curl is required to download ${description}."
  if ! curl --fail --silent --show-error --location --proto '=https' --proto-redir '=https' --output "${destination_file}" "${source_url}"; then
    die "Failed to download ${description}: ${source_url}"
  fi
  [[ -s ${destination_file} ]] || die "Downloaded ${description} is empty: ${source_url}"
}

json_single_string_value() {
  local metadata_file="$1"
  local field_name="$2"
  local field_pattern='^[[:space:]]*"'"${field_name}"'"[[:space:]]*:[[:space:]]*"([^"\\]*)"[[:space:]]*,?[[:space:]]*$'
  local metadata_line=""
  local -a field_values=()

  while IFS= read -r metadata_line || [[ -n ${metadata_line} ]]; do
    if [[ ${metadata_line} =~ ${field_pattern} ]]; then
      field_values+=("${BASH_REMATCH[1]}")
    fi
  done <"${metadata_file}"

  [[ ${#field_values[@]} -eq 1 ]] || return 1
  printf '%s\n' "${field_values[0]}"
}

narrow_json_document_is_valid() {
  local metadata_file="$1"
  local metadata_line=""
  local container_type=""
  local trailing_comma=""
  local depth=-1
  local parent_depth=-1
  local root_seen=false
  local root_closed=false
  local scalar_pattern='^[[:space:]]*"[a-z0-9_]+"[[:space:]]*:[[:space:]]*"[^"\\]*"[[:space:]]*([,]?)[[:space:]]*$'
  local object_member_pattern='^[[:space:]]*"[a-z0-9_]+"[[:space:]]*:[[:space:]]*\{[[:space:]]*$'
  local array_member_pattern='^[[:space:]]*"[a-z0-9_]+"[[:space:]]*:[[:space:]]*\[[[:space:]]*$'
  local close_object_pattern='^[[:space:]]*\}([,]?)[[:space:]]*$'
  local close_array_pattern='^[[:space:]]*\]([,]?)[[:space:]]*$'
  local -a container_types=()
  local -a item_counts=()
  local -a last_item_had_comma=()

  while IFS= read -r metadata_line || [[ -n ${metadata_line} ]]; do
    [[ -n ${metadata_line//[[:space:]]/} ]] || continue

    if [[ ${metadata_line} =~ ^[[:space:]]*\{[[:space:]]*$ ]]; then
      if ((depth < 0)); then
        [[ ${root_seen} == false && ${root_closed} == false ]] || return 1
        root_seen=true
      else
        [[ ${container_types[depth]} == array ]] || return 1
        [[ ${item_counts[depth]} -eq 0 || ${last_item_had_comma[depth]} == true ]] || return 1
      fi
      ((depth += 1))
      container_types[depth]=object
      item_counts[depth]=0
      last_item_had_comma[depth]=false
      continue
    fi

    ((depth >= 0)) || return 1

    if [[ ${metadata_line} =~ ${scalar_pattern} ]]; then
      [[ ${container_types[depth]} == object ]] || return 1
      [[ ${item_counts[depth]} -eq 0 || ${last_item_had_comma[depth]} == true ]] || return 1
      ((item_counts[depth] += 1))
      [[ ${BASH_REMATCH[1]} == , ]] && last_item_had_comma[depth]=true || last_item_had_comma[depth]=false
      continue
    fi

    if [[ ${metadata_line} =~ ${object_member_pattern} || ${metadata_line} =~ ${array_member_pattern} ]]; then
      [[ ${container_types[depth]} == object ]] || return 1
      [[ ${item_counts[depth]} -eq 0 || ${last_item_had_comma[depth]} == true ]] || return 1
      container_type=object
      [[ ${metadata_line} =~ ${array_member_pattern} ]] && container_type=array
      ((depth += 1))
      container_types[depth]="${container_type}"
      item_counts[depth]=0
      last_item_had_comma[depth]=false
      continue
    fi

    trailing_comma=""
    if [[ ${metadata_line} =~ ${close_object_pattern} ]]; then
      [[ ${container_types[depth]} == object ]] || return 1
      trailing_comma="${BASH_REMATCH[1]}"
    elif [[ ${metadata_line} =~ ${close_array_pattern} ]]; then
      [[ ${container_types[depth]} == array ]] || return 1
      trailing_comma="${BASH_REMATCH[1]}"
    else
      return 1
    fi

    [[ ${item_counts[depth]} -gt 0 && ${last_item_had_comma[depth]} == false ]] || return 1
    unset 'container_types[depth]' 'item_counts[depth]' 'last_item_had_comma[depth]'
    ((depth -= 1))

    if ((depth < 0)); then
      [[ ${trailing_comma} != , && ${root_closed} == false ]] || return 1
      root_closed=true
      continue
    fi

    parent_depth="${depth}"
    ((item_counts[parent_depth] += 1))
    [[ ${trailing_comma} == , ]] && last_item_had_comma[parent_depth]=true || last_item_had_comma[parent_depth]=false
  done <"${metadata_file}"

  [[ ${root_seen} == true && ${root_closed} == true && ${depth} -eq -1 ]]
}

prepare_family_root() {
  local sdk_family="$1"

  ACTIVE_FAMILY_ROOT="${MERRY_SETUP_HOME}/sdks/${sdk_family}"
  mkdir -p -- "${ACTIVE_FAMILY_ROOT}"
}

download_release_metadata() {
  local metadata_url="$1"
  local description="$2"

  ACTIVE_METADATA_FILE="$(mktemp "${ACTIVE_FAMILY_ROOT}/.metadata.XXXXXX")"
  download_file "${metadata_url}" "${ACTIVE_METADATA_FILE}" "${description}"
}

resolve_dart_release() {
  local requested_version="$1"
  local metadata_version=""

  RESOLVED_ARCHIVE_SHA256=""
  if [[ ${requested_version} == stable ]]; then
    download_release_metadata "${DART_RELEASE_BASE_URL}/latest/VERSION" "Dart release metadata"
    narrow_json_document_is_valid "${ACTIVE_METADATA_FILE}" || die "Dart release metadata is incomplete or malformed."
    if ! metadata_version="$(json_single_string_value "${ACTIVE_METADATA_FILE}" version)" || ! is_exact_semver "${metadata_version}"; then
      die "Dart release metadata does not contain exactly one valid version."
    fi
    RESOLVED_SDK_VERSION="${metadata_version}"
  else
    is_exact_semver "${requested_version}" || die "Dart SDK version must be 'stable' or an exact stable semantic version."
    RESOLVED_SDK_VERSION="${requested_version}"
  fi

  RESOLVED_DART_VERSION="${RESOLVED_SDK_VERSION}"
  require_minimum_dart_runtime "${RESOLVED_DART_VERSION}"
  RESOLVED_ARCHIVE_URL="${DART_RELEASE_BASE_URL}/${RESOLVED_SDK_VERSION}/sdk/dartsdk-linux-x64-release.zip"
}

parse_flutter_release_record() {
  local metadata_file="$1"
  local requested_version="$2"
  local current_stable_hash=""
  local metadata_line=""
  local field_name=""
  local field_value=""
  local record_hash=""
  local record_channel=""
  local record_version=""
  local record_dart_version=""
  local record_arch=""
  local record_archive=""
  local record_sha256=""
  local selected_count=0
  local in_releases=false
  local in_record=false
  local releases_count=0
  local saw_releases_end=false
  local releases_pattern='^[[:space:]]*"releases"[[:space:]]*:[[:space:]]*\[[[:space:]]*$'
  local field_pattern='^[[:space:]]*"([a-z0-9_]+)"[[:space:]]*:[[:space:]]*"([^"\\]*)"[[:space:]]*,?[[:space:]]*$'

  if [[ ${requested_version} == stable ]]; then
    current_stable_hash="$(json_single_string_value "${metadata_file}" stable)" || die "Flutter release metadata does not contain exactly one current stable hash."
    [[ -n ${current_stable_hash} ]] || die "Flutter release metadata does not contain exactly one current stable hash."
  else
    is_exact_semver "${requested_version}" || die "Flutter SDK version must be 'stable' or an exact stable semantic version."
  fi

  while IFS= read -r metadata_line || [[ -n ${metadata_line} ]]; do
    if [[ ${metadata_line} =~ ${releases_pattern} ]]; then
      ((releases_count += 1))
      [[ ${releases_count} -eq 1 ]] || die "Flutter release metadata is incomplete or malformed."
      in_releases=true
      continue
    fi
    [[ ${in_releases} == true ]] || continue

    if [[ ${in_record} == false && ${metadata_line} =~ ^[[:space:]]*\{[[:space:]]*$ ]]; then
      in_record=true
      record_hash=""
      record_channel=""
      record_version=""
      record_dart_version=""
      record_arch=""
      record_archive=""
      record_sha256=""
      continue
    fi

    if [[ ${in_record} == true && ${metadata_line} =~ ${field_pattern} ]]; then
      field_name="${BASH_REMATCH[1]}"
      field_value="${BASH_REMATCH[2]}"
      case "${field_name}" in
      hash) [[ -z ${record_hash} ]] || die "Flutter release metadata contains a duplicate release field."; record_hash="${field_value}" ;;
      channel) [[ -z ${record_channel} ]] || die "Flutter release metadata contains a duplicate release field."; record_channel="${field_value}" ;;
      version) [[ -z ${record_version} ]] || die "Flutter release metadata contains a duplicate release field."; record_version="${field_value}" ;;
      dart_sdk_version) [[ -z ${record_dart_version} ]] || die "Flutter release metadata contains a duplicate release field."; record_dart_version="${field_value}" ;;
      dart_sdk_arch) [[ -z ${record_arch} ]] || die "Flutter release metadata contains a duplicate release field."; record_arch="${field_value}" ;;
      archive) [[ -z ${record_archive} ]] || die "Flutter release metadata contains a duplicate release field."; record_archive="${field_value}" ;;
      sha256) [[ -z ${record_sha256} ]] || die "Flutter release metadata contains a duplicate release field."; record_sha256="${field_value}" ;;
      esac
      continue
    fi

    if [[ ${in_record} == true && ${metadata_line} =~ ^[[:space:]]*\}[,]?[[:space:]]*$ ]]; then
      in_record=false
      if [[ ${record_channel} == stable ]] && { [[ ${requested_version} == stable && ${record_hash} == "${current_stable_hash}" ]] || [[ ${requested_version} != stable && ${record_version} == "${requested_version}" ]]; }; then
        ((selected_count += 1))
        RESOLVED_SDK_VERSION="${record_version}"
        RESOLVED_DART_VERSION="${record_dart_version}"
        RESOLVED_DART_ARCH="${record_arch}"
        RESOLVED_ARCHIVE_URL="${record_archive}"
        RESOLVED_ARCHIVE_SHA256="${record_sha256}"
      fi
      continue
    fi

    if [[ ${in_record} == false && ${metadata_line} =~ ^[[:space:]]*\][,]?[[:space:]]*$ ]]; then
      saw_releases_end=true
      in_releases=false
    fi
  done <"${metadata_file}"

  [[ ${releases_count} -eq 1 && ${saw_releases_end} == true && ${in_record} == false ]] || die "Flutter release metadata is incomplete or malformed."
  [[ ${selected_count} -eq 1 ]] || die "Flutter release metadata does not contain exactly one selected stable release."
}

resolve_flutter_release() {
  local requested_version="$1"
  local base_url=""
  local runtime_version=""
  local checksum_pattern='^[0-9a-fA-F]{64}$'

  download_release_metadata "${FLUTTER_RELEASES_URL}" "Flutter release metadata"
  narrow_json_document_is_valid "${ACTIVE_METADATA_FILE}" || die "Flutter release metadata is incomplete or malformed."
  base_url="$(json_single_string_value "${ACTIVE_METADATA_FILE}" base_url)" || die "Flutter release metadata does not contain exactly one base URL."
  [[ ${base_url} == "${FLUTTER_RELEASE_BASE_URL}" ]] || die "Flutter release metadata contains an unsupported base URL."

  parse_flutter_release_record "${ACTIVE_METADATA_FILE}" "${requested_version}"
  if [[ -z ${RESOLVED_SDK_VERSION} || -z ${RESOLVED_DART_VERSION} || -z ${RESOLVED_ARCHIVE_URL} ]]; then
    die "Flutter release metadata is incomplete."
  fi
  is_exact_semver "${RESOLVED_SDK_VERSION}" || die "Flutter release metadata contains an invalid stable version."
  [[ ${RESOLVED_DART_ARCH} == x64 ]] || die "Flutter release metadata does not provide Linux x64."
  [[ ${RESOLVED_ARCHIVE_SHA256} =~ ${checksum_pattern} ]] || die "Flutter release metadata does not contain a valid checksum."
  [[ ${RESOLVED_ARCHIVE_URL} == stable/linux/* && ${RESOLVED_ARCHIVE_URL} != *../* ]] || die "Flutter release metadata contains an invalid archive path."

  runtime_version="$(extract_first_semver "${RESOLVED_DART_VERSION}")" || die "Flutter release metadata contains an invalid bundled Dart version."
  RESOLVED_DART_VERSION="${runtime_version}"
  require_minimum_dart_runtime "${RESOLVED_DART_VERSION}"
  RESOLVED_ARCHIVE_URL="${base_url}/${RESOLVED_ARCHIVE_URL}"
  RESOLVED_ARCHIVE_SHA256="${RESOLVED_ARCHIVE_SHA256,,}"
}

parse_dart_checksum() {
  local checksum_file="$1"
  local checksum_line=""
  local checksum_pattern='^([0-9a-fA-F]{64})[[:space:]]+\*?dartsdk-linux-x64-release\.zip$'
  local -a checksum_lines=()

  while IFS= read -r checksum_line || [[ -n ${checksum_line} ]]; do
    [[ -n ${checksum_line} ]] && checksum_lines+=("${checksum_line}")
  done <"${checksum_file}"

  [[ ${#checksum_lines[@]} -eq 1 && ${checksum_lines[0]} =~ ${checksum_pattern} ]] || die "Dart checksum metadata is missing or invalid."
  RESOLVED_ARCHIVE_SHA256="${BASH_REMATCH[1],,}"
}

extract_machine_value() {
  local machine_output="$1"
  local field_name="$2"
  local field_pattern='"'"${field_name}"'"[[:space:]]*:[[:space:]]*"([^"\\]+)"'

  [[ ${machine_output} =~ ${field_pattern} ]] || return 1
  printf '%s\n' "${BASH_REMATCH[1]}"
}

sdk_installation_is_valid() {
  local sdk_root="$1"
  local sdk_family="$2"
  local expected_sdk_version="$3"
  local expected_dart_version="$4"
  local dart_output=""
  local actual_dart_version=""
  local flutter_output=""
  local actual_flutter_version=""

  [[ ! -L ${sdk_root} && -d ${sdk_root} ]] || return 1
  [[ -x ${sdk_root}/bin/dart ]] || return 1
  if [[ ${sdk_family} == dart ]]; then
    [[ -f ${sdk_root}/include/dart_api.h && ! -L ${sdk_root}/include/dart_api.h ]] || return 1
    [[ ! -e ${sdk_root}/bin/flutter && ! -L ${sdk_root}/bin/flutter ]] || return 1
  fi
  dart_output="$("${sdk_root}/bin/dart" --version 2>&1)" || return 1
  actual_dart_version="$(extract_first_semver "${dart_output}")" || return 1
  [[ ${actual_dart_version} == "${expected_dart_version}" ]] || return 1
  version_is_at_least "${actual_dart_version}" "${MINIMUM_DART_RUNTIME}" || return 1

  if [[ ${sdk_family} == flutter ]]; then
    [[ -x ${sdk_root}/bin/flutter ]] || return 1
    flutter_output="$("${sdk_root}/bin/flutter" --version --machine 2>&1)" || return 1
    actual_flutter_version="$(extract_machine_value "${flutter_output}" frameworkVersion)" || return 1
    actual_dart_version="$(extract_machine_value "${flutter_output}" dartSdkVersion)" || return 1
    actual_dart_version="$(extract_first_semver "${actual_dart_version}")" || return 1
    [[ ${actual_flutter_version} == "${expected_sdk_version}" && ${actual_dart_version} == "${expected_dart_version}" ]] || return 1
  fi
}

verify_archive_checksum() {
  local archive_file="$1"
  local expected_checksum="$2"
  local checksum_output=""
  local actual_checksum=""
  local checksum_pattern='^[0-9a-fA-F]{64}$'

  command -v sha256sum >/dev/null 2>&1 || die "sha256sum is required to verify SDK archives."
  checksum_output="$(sha256sum "${archive_file}")" || die "Failed to calculate SDK archive checksum."
  actual_checksum="${checksum_output%%[[:space:]]*}"
  [[ ${actual_checksum} =~ ${checksum_pattern} ]] || die "sha256sum returned an invalid SDK archive checksum."
  [[ ${actual_checksum,,} == "${expected_checksum,,}" ]] || die "SDK archive checksum mismatch."
}

install_resolved_sdk() {
  local sdk_family="$1"
  local family_label="Dart"
  local final_sdk="${ACTIVE_FAMILY_ROOT}/${RESOLVED_SDK_VERSION}"
  local archive_file=""
  local checksum_file=""
  local extract_root=""
  local staged_sdk=""
  local publish_command_succeeded=false

  [[ ${sdk_family} == flutter ]] && family_label=Flutter

  if [[ -e ${final_sdk} || -L ${final_sdk} ]]; then
    if sdk_installation_is_valid "${final_sdk}" "${sdk_family}" "${RESOLVED_SDK_VERSION}" "${RESOLVED_DART_VERSION}"; then
      CURRENT_SDK_ROOT="${final_sdk}"
      printf 'Reusing %s SDK %s from %s\n' "${family_label}" "${RESOLVED_SDK_VERSION}" "${final_sdk}"
      return 0
    fi
    die "Existing ${family_label} SDK installation is invalid: ${final_sdk}. Remove or repair this directory before retrying."
  fi

  ACTIVE_STAGE_DIR="$(mktemp -d "${ACTIVE_FAMILY_ROOT}/.${RESOLVED_SDK_VERSION}.staging.XXXXXX")"
  archive_file="${ACTIVE_STAGE_DIR}/sdk-archive"
  extract_root="${ACTIVE_STAGE_DIR}/extract"
  mkdir -p -- "${extract_root}"

  if [[ ${sdk_family} == dart ]]; then
    checksum_file="${ACTIVE_STAGE_DIR}/sdk-archive.sha256sum"
    download_file "${RESOLVED_ARCHIVE_URL}.sha256sum" "${checksum_file}" "Dart SDK checksum metadata"
    parse_dart_checksum "${checksum_file}"
  fi

  download_file "${RESOLVED_ARCHIVE_URL}" "${archive_file}" "${family_label} SDK archive"
  verify_archive_checksum "${archive_file}" "${RESOLVED_ARCHIVE_SHA256}"

  if [[ ${sdk_family} == dart ]]; then
    command -v unzip >/dev/null 2>&1 || die "unzip is required to extract the Dart SDK archive."
    unzip -q "${archive_file}" -d "${extract_root}" || die "Failed to extract Dart SDK archive."
    staged_sdk="${extract_root}/dart-sdk"
  else
    command -v tar >/dev/null 2>&1 || die "tar is required to extract the Flutter SDK archive."
    tar -xJf "${archive_file}" -C "${extract_root}" || die "Failed to extract Flutter SDK archive."
    staged_sdk="${extract_root}/flutter"
  fi

  if ! sdk_installation_is_valid "${staged_sdk}" "${sdk_family}" "${RESOLVED_SDK_VERSION}" "${RESOLVED_DART_VERSION}"; then
    die "Staged ${family_label} SDK does not match release metadata."
  fi

  if mv --no-clobber --no-target-directory -- "${staged_sdk}" "${final_sdk}"; then
    publish_command_succeeded=true
  fi

  if [[ ${publish_command_succeeded} == true && ! -e ${staged_sdk} && ! -L ${staged_sdk} ]] && sdk_installation_is_valid "${final_sdk}" "${sdk_family}" "${RESOLVED_SDK_VERSION}" "${RESOLVED_DART_VERSION}"; then
    CURRENT_SDK_ROOT="${final_sdk}"
  elif [[ -e ${final_sdk} || -L ${final_sdk} ]] && sdk_installation_is_valid "${final_sdk}" "${sdk_family}" "${RESOLVED_SDK_VERSION}" "${RESOLVED_DART_VERSION}"; then
    CURRENT_SDK_ROOT="${final_sdk}"
    printf 'Reusing concurrently published %s SDK %s from %s\n' "${family_label}" "${RESOLVED_SDK_VERSION}" "${final_sdk}"
  else
    die "Failed to publish ${family_label} SDK ${RESOLVED_SDK_VERSION} atomically."
  fi

  printf 'Installed %s SDK %s at %s\n' "${family_label}" "${RESOLVED_SDK_VERSION}" "${CURRENT_SDK_ROOT}"
}

log_resolved_sdk() {
  local sdk_family="$1"
  local executable_name=dart

  [[ ${sdk_family} == flutter ]] && executable_name=flutter
  printf 'Resolved SDK: family=%s version=%s host_architecture=%s executable=%s/bin/%s\n' "${sdk_family}" "${RESOLVED_SDK_VERSION}" "${HOST_ARCHITECTURE}" "${CURRENT_SDK_ROOT}" "${executable_name}"
}

resolve_and_install_sdk() {
  local sdk_family="$1"
  local requested_version="$2"

  prepare_family_root "${sdk_family}"
  if [[ ${sdk_family} == dart ]]; then
    resolve_dart_release "${requested_version}"
  else
    resolve_flutter_release "${requested_version}"
  fi
  install_resolved_sdk "${sdk_family}"
  log_resolved_sdk "${sdk_family}"
}

activation_plan_contains() {
  local package_name="$1"

  [[ ${ACTIVATION_PACKAGE_INDEX[${package_name}]+present} == present ]]
}

add_activation_package() {
  local package_name="$1"
  local package_constraint="$2"
  local package_index="${#ACTIVATION_PACKAGE_NAMES[@]}"

  ACTIVATION_PACKAGE_INDEX["${package_name}"]="${package_index}"
  ACTIVATION_PACKAGE_NAMES+=("${package_name}")
  ACTIVATION_PACKAGE_CONSTRAINTS+=("${package_constraint}")
}

validate_bundles() {
  local bundle_name=""
  local -A seen_bundles=()

  FLUTTERFIRE_BUNDLE_ENABLED=false
  for bundle_name in "$@"; do
    [[ -n ${bundle_name} && ! ${bundle_name} =~ [[:cntrl:]] ]] || die "Invalid bundle name."
    [[ ${seen_bundles[${bundle_name}]+present} != present ]] || die "Bundle '${bundle_name}' was provided more than once."
    seen_bundles["${bundle_name}"]=true

    case "${bundle_name}" in
    flutterfire)
      FLUTTERFIRE_BUNDLE_ENABLED=true
      ;;
    *)
      die "Unsupported bundle: '${bundle_name}'."
      ;;
    esac
  done
}

validate_firebase_tools() {
  local firebase_tools_version="$1"

  if [[ -n ${firebase_tools_version} ]]; then
    [[ ${FLUTTERFIRE_BUNDLE_ENABLED} == true ]] || die "Option '--firebase-tools-version' requires the 'flutterfire' bundle."
    is_exact_semver "${firebase_tools_version}" || die "Option '--firebase-tools-version' must be an exact semantic version."
  fi

  if [[ ${FLUTTERFIRE_BUNDLE_ENABLED} == true ]]; then
    NPM_EXECUTABLE="$(command -v npm)" || die "npm is required for the 'flutterfire' bundle."
    [[ ${NPM_EXECUTABLE} == /* && -x ${NPM_EXECUTABLE} ]] || die "npm is required for the 'flutterfire' bundle."
  fi
}

validate_precache_targets() {
  local precache_input=""
  local precache_target=""
  local -a precache_targets=()

  PRECACHE_ANDROID=false
  PRECACHE_WEB=false
  PRECACHE_LINUX=false

  for precache_input in "$@"; do
    [[ -n ${precache_input} && ! ${precache_input} =~ [[:cntrl:]] ]] || die "Option '--precache' requires a nonempty target list."
    if [[ ${precache_input} == ,* || ${precache_input} == *, || ${precache_input} == *,,* ]]; then
      die "Option '--precache' contains an empty target in '${precache_input}'."
    fi

    IFS=, read -r -a precache_targets <<<"${precache_input}"
    for precache_target in "${precache_targets[@]}"; do
      case "${precache_target}" in
      android)
        PRECACHE_ANDROID=true
        ;;
      web)
        PRECACHE_WEB=true
        ;;
      linux)
        PRECACHE_LINUX=true
        ;;
      *)
        die "Option '--precache' must contain only android, web, or linux targets; received '${precache_target}'."
        ;;
      esac
    done
  done
}

run_flutter_precache() {
  local -a precache_command=("${CURRENT_SDK_ROOT}/bin/flutter" precache)

  if [[ ${PRECACHE_ANDROID} == false && ${PRECACHE_WEB} == false && ${PRECACHE_LINUX} == false ]]; then
    return 0
  fi

  if [[ ${PRECACHE_ANDROID} == true ]]; then
    precache_command+=(--android)
  fi
  if [[ ${PRECACHE_WEB} == true ]]; then
    precache_command+=(--web)
  fi
  if [[ ${PRECACHE_LINUX} == true ]]; then
    precache_command+=(--linux)
  fi

  "${precache_command[@]}" || die "Flutter precache failed: ${precache_command[*]:2}"
  printf 'Flutter precache completed: %s\n' "${precache_command[*]:2}"
}

shell_single_quote() {
  local value="$1"
  local quote="'"

  printf "'%s'" "${value//${quote}/${quote}\\${quote}${quote}}"
}

validate_trunk_path() {
  local requested_path="$1"
  local launcher_dir=""

  TRUNK_LAUNCHER=""
  [[ -n ${requested_path} ]] || return 0
  [[ ! ${requested_path} =~ [[:cntrl:]] && -f ${requested_path} && -x ${requested_path} ]] || die "Option '--trunk-path' must point to an executable Trunk launcher; received '${requested_path}'."
  launcher_dir="${requested_path%/*}"
  [[ ${requested_path} == */* ]] || launcher_dir=.
  [[ -n ${launcher_dir} ]] || launcher_dir=/
  launcher_dir="$(cd "${launcher_dir}" && pwd -P)" || die "Option '--trunk-path' could not be resolved: '${requested_path}'."
  TRUNK_LAUNCHER="${launcher_dir}/${requested_path##*/}"
}

validate_persistence_environment() {
  local persistence_adapter="$1"

  case "${persistence_adapter}" in
  github)
    [[ -n ${GITHUB_ENV:-} && -f ${GITHUB_ENV} && -w ${GITHUB_ENV} ]] || die "GITHUB_ENV must point to a writable file when '--persist-path github' is selected."
    [[ -n ${GITHUB_PATH:-} && -f ${GITHUB_PATH} && -w ${GITHUB_PATH} ]] || die "GITHUB_PATH must point to a writable file when '--persist-path github' is selected."
    ;;
  bashrc)
    [[ -n ${HOME:-} && -d ${HOME} ]] || die "HOME must point to a directory when '--persist-path bashrc' is selected."
    ;;
  esac
}

resolve_trunk_launcher() {
  local project_dir="$1"
  local candidate_path=""
  local final_launcher="${LOCAL_TOOL_BIN}/trunk"

  if [[ -z ${TRUNK_LAUNCHER} ]]; then
    for candidate_path in "${project_dir}/.trunk/bin/trunk" "${project_dir}/tools/trunk" "${project_dir}/trunk" "${final_launcher}"; do
      if [[ -f ${candidate_path} && -x ${candidate_path} ]]; then
        TRUNK_LAUNCHER="${candidate_path}"
        break
      fi
    done
  fi

  if [[ -z ${TRUNK_LAUNCHER} ]]; then
    mkdir -p -- "${LOCAL_TOOL_BIN}"
    ACTIVE_TRUNK_STAGE="$(mktemp "${LOCAL_TOOL_BIN}/.trunk.XXXXXX")"
    download_file "${TRUNK_LAUNCHER_URL}" "${ACTIVE_TRUNK_STAGE}" "Trunk launcher"
    chmod 0755 "${ACTIVE_TRUNK_STAGE}"
    # Validate the staged download before publishing it, so a truncated file or an HTTP error page never becomes the reused launcher.
    "${ACTIVE_TRUNK_STAGE}" version || die "Downloaded Trunk launcher failed to report its version; it was not installed."
    mv -f -- "${ACTIVE_TRUNK_STAGE}" "${final_launcher}" || die "Failed to install the Trunk launcher at ${final_launcher}."
    ACTIVE_TRUNK_STAGE=""
    TRUNK_LAUNCHER="${final_launcher}"
    printf 'Trunk launcher: %s\n' "${TRUNK_LAUNCHER}"
    return 0
  fi

  printf 'Trunk launcher: %s\n' "${TRUNK_LAUNCHER}"
  "${TRUNK_LAUNCHER}" version || die "Trunk launcher failed to report its version: ${TRUNK_LAUNCHER}"
}

write_bashrc_block() {
  local sdk_bin="$1"
  local pub_bin="$2"
  local bashrc_file="${HOME}/.bashrc"
  local bashrc_line=""
  local block_count=0
  local in_block=false
  local malformed_message="${bashrc_file} contains an incomplete, duplicated, or misordered merry-setup managed block; repair it before rerunning."

  if [[ -L ${bashrc_file} ]]; then
    # Write through a symlinked .bashrc (a dotfiles checkout, for example) to its target so the link survives.
    command -v readlink >/dev/null 2>&1 || die "${bashrc_file} is a symbolic link and readlink is unavailable to resolve it."
    bashrc_file="$(readlink -f "${bashrc_file}")" || die "Failed to resolve the symbolic link ${HOME}/.bashrc."
  fi

  if [[ -e ${bashrc_file} ]]; then
    [[ -f ${bashrc_file} ]] || die "${bashrc_file} is not a regular file."
    while IFS= read -r bashrc_line || [[ -n ${bashrc_line} ]]; do
      if [[ ${bashrc_line} == "${BASHRC_BLOCK_BEGIN}" ]]; then
        [[ ${in_block} == false && ${block_count} -eq 0 ]] || die "${malformed_message}"
        in_block=true
      elif [[ ${bashrc_line} == "${BASHRC_BLOCK_END}" ]]; then
        [[ ${in_block} == true ]] || die "${malformed_message}"
        in_block=false
        ((block_count += 1))
      fi
    done <"${bashrc_file}"
    [[ ${in_block} == false ]] || die "${malformed_message}"
  fi

  ACTIVE_BASHRC_TEMP="$(mktemp "${bashrc_file%/*}/.bashrc.merry-setup.XXXXXX")"
  if [[ -f ${bashrc_file} ]]; then
    cp -p -- "${bashrc_file}" "${ACTIVE_BASHRC_TEMP}" || die "Failed to stage ${bashrc_file} for rewriting."
  fi
  {
    if [[ -f ${bashrc_file} ]]; then
      while IFS= read -r bashrc_line || [[ -n ${bashrc_line} ]]; do
        if [[ ${bashrc_line} == "${BASHRC_BLOCK_BEGIN}" ]]; then
          in_block=true
          continue
        fi
        if [[ ${bashrc_line} == "${BASHRC_BLOCK_END}" ]]; then
          in_block=false
          continue
        fi
        [[ ${in_block} == true ]] || printf '%s\n' "${bashrc_line}"
      done <"${bashrc_file}"
    fi
    printf '%s\n' \
      "${BASHRC_BLOCK_BEGIN}" \
      "export PUB_CACHE=$(shell_single_quote "${PUB_CACHE}")" \
      "export PATH=$(shell_single_quote "${sdk_bin}"):$(shell_single_quote "${pub_bin}"):$(shell_single_quote "${LOCAL_TOOL_BIN}"):\"\${PATH}\"" \
      "${BASHRC_BLOCK_END}"
  } >"${ACTIVE_BASHRC_TEMP}"
  # The staged copy carries the original mode, and the rename publishes the complete file in one step.
  mv -f -- "${ACTIVE_BASHRC_TEMP}" "${bashrc_file}" || die "Failed to update ${bashrc_file}."
  ACTIVE_BASHRC_TEMP=""
}

apply_path_persistence() {
  local persistence_adapter="$1"
  local sdk_bin="${CURRENT_SDK_ROOT}/bin"
  local pub_bin="${PUB_CACHE}/bin"

  case "${persistence_adapter}" in
  none)
    ;;
  github)
    printf 'PUB_CACHE=%s\n' "${PUB_CACHE}" >>"${GITHUB_ENV}" || die "Failed to write PUB_CACHE to GITHUB_ENV."
    printf '%s\n' "${LOCAL_TOOL_BIN}" "${pub_bin}" "${sdk_bin}" >>"${GITHUB_PATH}" || die "Failed to write PATH entries to GITHUB_PATH."
    ;;
  bashrc)
    write_bashrc_block "${sdk_bin}" "${pub_bin}"
    ;;
  esac

  printf 'Persisted PUB_CACHE and PATH: adapter=%s\n' "${persistence_adapter}"
}

is_valid_dart_package_name() {
  local package_name="$1"

  [[ ${package_name} =~ ^[a-z][a-z0-9_]*$ ]] || return 1
  case "${package_name}" in
  abstract | as | assert | await | break | case | catch | class | const | continue | covariant | default | deferred | do | else | enum | export | extends | external | false | final | finally | for | hide | if | implements | import | in | inline | interface | is | late | library | mixin | new | null | of | on | operator | part | required | rethrow | return | sealed | set | super | switch | this | throw | true | try | type | var | void | while | with | yield)
    return 1
    ;;
  esac
}

build_activation_plan() {
  local merry_enabled="$1"
  local merry_version="$2"
  local merry_version_provided="$3"
  local bootstrap_strategy="$4"
  shift 4

  local package_entry=""
  local package_name=""
  local package_constraint=""
  local -A explicit_packages=()

  ACTIVATION_PACKAGE_NAMES=()
  ACTIVATION_PACKAGE_CONSTRAINTS=()
  ACTIVATION_PACKAGE_INDEX=()

  if [[ ${merry_enabled} == true ]]; then
    if [[ ${merry_version_provided} == true ]]; then
      [[ -n ${merry_version} && ${merry_version} != -* && ! ${merry_version} =~ [[:cntrl:]] ]] || die "Option '--merry-version' has an invalid constraint."
    fi
    add_activation_package merry "${merry_version}"
  fi

  for package_entry in "$@"; do
    [[ -n ${package_entry} && ! ${package_entry} =~ [[:cntrl:]] ]] || die "Invalid Dart package entry."
    package_name="${package_entry%%=*}"
    package_constraint=""
    if [[ ${package_entry} == *=* ]]; then
      package_constraint="${package_entry#*=}"
      [[ -n ${package_constraint} ]] || die "Dart package '${package_name}' has an empty constraint."
      [[ ${package_constraint} != -* && ! ${package_constraint} =~ [[:cntrl:]] ]] || die "Dart package '${package_name}' has an invalid constraint."
    fi

    is_valid_dart_package_name "${package_name}" || die "Invalid Dart package name: '${package_name}'."
    [[ ${package_name} != merry ]] || die "Dart package 'merry' must be configured through Merry options."
    [[ ${explicit_packages[${package_name}]+present} != present ]] || die "Dart package '${package_name}' was provided more than once."
    explicit_packages["${package_name}"]=true
    add_activation_package "${package_name}" "${package_constraint}"
  done

  case "${bootstrap_strategy}" in
  melos)
    activation_plan_contains melos || add_activation_package melos ""
    ;;
  very-good)
    activation_plan_contains very_good_cli || add_activation_package very_good_cli ""
    ;;
  esac

  if [[ ${FLUTTERFIRE_BUNDLE_ENABLED} == true ]]; then
    activation_plan_contains flutterfire_cli || add_activation_package flutterfire_cli ""
  fi
}

resolve_pub_cache() {
  local sdk_family="$1"

  if [[ ${PUB_CACHE+x} != x ]]; then
    PUB_CACHE="${MERRY_SETUP_HOME}/pub-cache/${sdk_family}/${RESOLVED_SDK_VERSION}"
  fi
  export PUB_CACHE

  mkdir -p -- "${PUB_CACHE}/bin"
  PATH="${CURRENT_SDK_ROOT}/bin:${PUB_CACHE}/bin:${LOCAL_TOOL_BIN}${NPM_GLOBAL_BIN:+:${NPM_GLOBAL_BIN}}${PATH:+:${PATH}}"
  export PATH
  printf 'Resolved PUB_CACHE: %s\n' "${PUB_CACHE}"
}

known_tool_executable() {
  local package_name="$1"

  case "${package_name}" in
  merry | melos)
    printf '%s\n' "${package_name}"
    ;;
  very_good_cli)
    printf '%s\n' very_good
    ;;
  flutterfire_cli)
    printf '%s\n' flutterfire
    ;;
  *)
    return 1
    ;;
  esac
}

log_known_tool_version() {
  local package_name="$1"
  local tool_executable=""
  local tool_path=""
  local tool_output=""
  local tool_version=""

  tool_executable="$(known_tool_executable "${package_name}")" || return 0
  tool_path="${PUB_CACHE}/bin/${tool_executable}"
  [[ -x ${tool_path} ]] || die "Activated Dart package '${package_name}' did not provide the expected executable: ${tool_path}"
  tool_output="$("${tool_path}" --version 2>&1)" || die "Failed to read the version of activated Dart package '${package_name}'."
  tool_version="$(extract_first_reported_version "${tool_output}")" || die "Activated Dart package '${package_name}' returned an invalid version."
  printf 'Tool version: package=%s executable=%s version=%s\n' "${package_name}" "${tool_executable}" "${tool_version}"
}

log_activated_package_versions() {
  local package_list_output=""
  local planned_name=""
  local listed_name=""
  local listed_version=""
  local trailing_value=""
  local matched_version=""
  local matched_count=0

  ((${#ACTIVATION_PACKAGE_NAMES[@]} > 0)) || return 0
  package_list_output="$("${CURRENT_SDK_ROOT}/bin/dart" pub global list)" || die "Failed to list activated Dart packages."

  for planned_name in "${ACTIVATION_PACKAGE_NAMES[@]}"; do
    matched_version=""
    matched_count=0
    while IFS=$' \t' read -r listed_name listed_version trailing_value; do
      if [[ ${listed_name} == "${planned_name}" && -n ${listed_version} && -z ${trailing_value} ]]; then
        matched_version="${listed_version}"
        ((matched_count += 1))
      fi
    done <<<"${package_list_output}"
    [[ ${matched_count} -eq 1 ]] || die "Unable to determine the activated version for Dart package '${planned_name}'."
    printf 'Activated Dart package: name=%s version=%s\n' "${planned_name}" "${matched_version}"
    log_known_tool_version "${planned_name}"
  done
}

activate_global_packages() {
  local package_index=0
  local package_name=""
  local package_constraint=""
  local -a activate_command=()

  for ((package_index = 0; package_index < ${#ACTIVATION_PACKAGE_NAMES[@]}; package_index += 1)); do
    package_name="${ACTIVATION_PACKAGE_NAMES[package_index]}"
    package_constraint="${ACTIVATION_PACKAGE_CONSTRAINTS[package_index]}"
    activate_command=("${CURRENT_SDK_ROOT}/bin/dart" pub global activate "${package_name}")
    if [[ -n ${package_constraint} ]]; then
      activate_command+=("${package_constraint}")
    fi
    "${activate_command[@]}" || die "Failed to activate Dart package '${package_name}'."
  done

  log_activated_package_versions
}

install_flutterfire_bundle() {
  local firebase_tools_version="$1"
  local firebase_package=firebase-tools
  local npm_global_prefix=""
  local npm_global_bin=""
  local firebase_executable=""
  local firebase_output=""
  local actual_firebase_version=""

  [[ ${FLUTTERFIRE_BUNDLE_ENABLED} == true ]] || return 0
  if [[ -n ${firebase_tools_version} ]]; then
    firebase_package="firebase-tools@${firebase_tools_version}"
  fi

  npm_global_prefix="$("${NPM_EXECUTABLE}" prefix --global)" || die "Failed to determine the npm global prefix."
  validate_absolute_path "npm global prefix" "${npm_global_prefix}"
  npm_global_bin="${npm_global_prefix}/bin"
  NPM_GLOBAL_BIN="${npm_global_bin}"
  firebase_executable="${npm_global_bin}/firebase"
  "${NPM_EXECUTABLE}" install --global "${firebase_package}" || die "Failed to install Firebase Tools through npm."
  [[ -x ${firebase_executable} ]] || die "Firebase Tools was installed but the expected executable is unavailable: ${firebase_executable}"
  firebase_output="$("${firebase_executable}" --version 2>&1)" || die "Failed to read the installed Firebase Tools version."
  actual_firebase_version="$(extract_first_semver "${firebase_output}")" || die "Firebase Tools returned an invalid version."
  if [[ -n ${firebase_tools_version} && ${actual_firebase_version} != "${firebase_tools_version}" ]]; then
    die "Installed Firebase Tools version ${actual_firebase_version} does not match requested version ${firebase_tools_version}."
  fi
  printf 'Firebase Tools version: %s\n' "${actual_firebase_version}"
}

locate_path_sdk() {
  local sdk_family="$1"
  local requested_version="$2"
  local executable_path=""
  local sdk_root=""
  local dart_output=""
  local flutter_output=""
  local machine_dart_version=""

  executable_path="$(command -v "${sdk_family}")" || die "The ${sdk_family} executable was not found on PATH; run 'merry-setup setup' before 'merry-setup bootstrap'."
  [[ ${executable_path} == /* && -x ${executable_path} ]] || die "The ${sdk_family} executable on PATH is not an absolute executable path: ${executable_path}"
  if command -v readlink >/dev/null 2>&1; then
    executable_path="$(readlink -f "${executable_path}")" || die "Failed to resolve the ${sdk_family} executable path: ${executable_path}"
  fi
  [[ ${executable_path%/*} == */bin ]] || die "The ${sdk_family} executable is not inside an SDK bin directory: ${executable_path}"
  sdk_root="$(cd "${executable_path%/*}/.." && pwd -P)" || die "Failed to resolve the ${sdk_family} SDK root for ${executable_path}"

  dart_output="$("${sdk_root}/bin/dart" --version 2>&1)" || die "The located Dart executable failed to report its version: ${sdk_root}/bin/dart"
  RESOLVED_DART_VERSION="$(extract_first_semver "${dart_output}")" || die "The located Dart executable reported an invalid version."
  if [[ ${sdk_family} == flutter ]]; then
    flutter_output="$("${sdk_root}/bin/flutter" --version --machine 2>&1)" || die "The located Flutter executable failed to report its version: ${sdk_root}/bin/flutter"
    RESOLVED_SDK_VERSION="$(extract_machine_value "${flutter_output}" frameworkVersion)" || die "The located Flutter executable reported an invalid framework version."
    machine_dart_version="$(extract_machine_value "${flutter_output}" dartSdkVersion)" || die "The located Flutter executable reported an invalid bundled Dart version."
    RESOLVED_DART_VERSION="$(extract_first_semver "${machine_dart_version}")" || die "The located Flutter executable reported an invalid bundled Dart version."
  else
    RESOLVED_SDK_VERSION="${RESOLVED_DART_VERSION}"
  fi

  require_minimum_dart_runtime "${RESOLVED_DART_VERSION}"
  if [[ ${requested_version} != stable && ${requested_version} != "${RESOLVED_SDK_VERSION}" ]]; then
    die "Located ${sdk_family} SDK ${RESOLVED_SDK_VERSION} does not match requested version ${requested_version}."
  fi
  sdk_installation_is_valid "${sdk_root}" "${sdk_family}" "${RESOLVED_SDK_VERSION}" "${RESOLVED_DART_VERSION}" || die "Located ${sdk_family} SDK at ${sdk_root} failed validation."
  CURRENT_SDK_ROOT="${sdk_root}"
  log_resolved_sdk "${sdk_family}"
}

lockfile_is_tracked() {
  local project_dir="$1"

  [[ -f ${project_dir}/pubspec.lock ]] || return 1
  command -v git >/dev/null 2>&1 || return 1
  git -C "${project_dir}" ls-files --error-unmatch pubspec.lock >/dev/null 2>&1
}

run_project_bootstrap() {
  local bootstrap_strategy="$1"
  local project_dir="$2"
  local tool_path=""
  local enforce_lockfile=false
  local -a bootstrap_command=()

  [[ ${bootstrap_strategy} != none ]] || return 0
  if lockfile_is_tracked "${project_dir}"; then
    enforce_lockfile=true
  fi

  case "${bootstrap_strategy}" in
  dart)
    bootstrap_command=("${CURRENT_SDK_ROOT}/bin/dart" pub get)
    ;;
  flutter)
    bootstrap_command=("${CURRENT_SDK_ROOT}/bin/flutter" pub get)
    ;;
  melos)
    tool_path="${PUB_CACHE}/bin/melos"
    [[ -x ${tool_path} ]] || die "melos is unavailable at ${tool_path}; run 'merry-setup setup --bootstrap melos' first."
    bootstrap_command=("${tool_path}" bootstrap)
    ;;
  very-good)
    tool_path="${PUB_CACHE}/bin/very_good"
    [[ -x ${tool_path} ]] || die "very_good is unavailable at ${tool_path}; run 'merry-setup setup --bootstrap very-good' first."
    bootstrap_command=("${tool_path}" packages get --recursive)
    enforce_lockfile=false
    ;;
  esac

  if [[ ${enforce_lockfile} == true ]]; then
    bootstrap_command+=(--enforce-lockfile)
  fi

  (cd "${project_dir}" && "${bootstrap_command[@]}") || die "Project bootstrap failed: strategy=${bootstrap_strategy} command=${bootstrap_command[*]}"
  printf 'Project bootstrap completed: strategy=%s command=%s\n' "${bootstrap_strategy}" "${bootstrap_command[*]}"
}

main() {
  local command_name=""
  local sdk_family=""
  local sdk_version="stable"
  local bootstrap_strategy=""
  local persistence_adapter=""
  local project_dir="${PWD}"
  local resolved_project_dir=""
  local merry_enabled="true"
  local merry_version=""
  local merry_version_provided=false
  local firebase_tools_version=""
  local trunk_path=""
  local managed_home=""
  local option_name=""
  local option_value=""
  local -a dart_packages=()
  local -a bundles=()
  local -a precache_inputs=()

  (($# > 0)) || die "Command is required."

  command_name="$1"
  shift

  case "${command_name}" in
  setup | bootstrap)
    ;;
  help | -h | --help)
    usage
    return 0
    ;;
  *)
    die "Unknown command: ${command_name}"
    ;;
  esac

  while (($# > 0)); do
    option_name="$1"

    case "${option_name}" in
    --no-merry)
      merry_enabled="false"
      shift
      ;;
    --sdk | --sdk-version | --bootstrap | --persist-path | --project-dir | --merry-version | --dart-package | --bundle | --firebase-tools-version | --precache | --trunk-path)
      require_option_value "${option_name}" "$#" "${2-}"
      option_value="$2"

      case "${option_name}" in
      --sdk)
        sdk_family="${option_value}"
        ;;
      --sdk-version)
        sdk_version="${option_value}"
        ;;
      --bootstrap)
        bootstrap_strategy="${option_value}"
        ;;
      --persist-path)
        persistence_adapter="${option_value}"
        ;;
      --project-dir)
        project_dir="${option_value}"
        ;;
      --merry-version)
        merry_version="${option_value}"
        merry_version_provided=true
        ;;
      --dart-package)
        dart_packages+=("${option_value}")
        ;;
      --bundle)
        bundles+=("${option_value}")
        ;;
      --firebase-tools-version)
        firebase_tools_version="${option_value}"
        ;;
      --precache)
        precache_inputs+=("${option_value}")
        ;;
      --trunk-path)
        trunk_path="${option_value}"
        ;;
      esac

      shift 2
      ;;
    *)
      die "Unknown option: ${option_name}"
      ;;
    esac
  done

  [[ -n ${sdk_family} ]] || die "Option '--sdk' is required."
  [[ -n ${bootstrap_strategy} ]] || die "Option '--bootstrap' is required."
  [[ -n ${persistence_adapter} ]] || die "Option '--persist-path' is required."

  case "${sdk_family}" in
  dart | flutter)
    ;;
  *)
    die "Option '--sdk' must be one of: dart, flutter; received '${sdk_family}'."
    ;;
  esac

  case "${bootstrap_strategy}" in
  none | dart | flutter | melos | very-good)
    ;;
  *)
    die "Option '--bootstrap' must be one of: none, dart, flutter, melos, very-good; received '${bootstrap_strategy}'."
    ;;
  esac

  case "${persistence_adapter}" in
  bashrc | github | none)
    ;;
  *)
    die "Option '--persist-path' must be one of: bashrc, github, none; received '${persistence_adapter}'."
    ;;
  esac

  if [[ ${merry_enabled} == false && ${merry_version_provided} == true ]]; then
    die "Option '--merry-version' conflicts with '--no-merry'."
  fi

  if [[ ${bootstrap_strategy} == flutter && ${sdk_family} != flutter ]]; then
    die "Option '--bootstrap flutter' requires '--sdk flutter'."
  fi

  if [[ ${sdk_family} == dart && ${#precache_inputs[@]} -gt 0 ]]; then
    die "Option '--precache' is invalid when '--sdk dart' is selected."
  fi
  validate_precache_targets "${precache_inputs[@]}"

  if [[ ${MERRY_SETUP_HOME+x} == x ]]; then
    managed_home="${MERRY_SETUP_HOME}"
  else
    [[ -n ${HOME:-} ]] || die "HOME is required when MERRY_SETUP_HOME is unset."
    managed_home="${HOME}/.merry-setup"
  fi
  validate_absolute_path "MERRY_SETUP_HOME" "${managed_home}"
  export MERRY_SETUP_HOME="${managed_home}"
  LOCAL_TOOL_BIN="${managed_home}/bin"
  validate_trunk_path "${trunk_path}"
  validate_persistence_environment "${persistence_adapter}"

  if [[ ${PUB_CACHE+x} == x ]]; then
    validate_absolute_path "PUB_CACHE" "${PUB_CACHE}"
  fi

  if [[ ${project_dir} == /* ]]; then
    resolved_project_dir="${project_dir}"
  else
    resolved_project_dir="${PWD}/${project_dir}"
  fi

  if [[ ${bootstrap_strategy} != none ]]; then
    [[ -d ${resolved_project_dir} ]] || die "Project directory does not exist: ${project_dir}"
    [[ -f ${resolved_project_dir}/pubspec.yaml ]] || die "Project directory does not contain pubspec.yaml: ${project_dir}"
  fi

  validate_bundles "${bundles[@]}"
  validate_firebase_tools "${firebase_tools_version}"
  build_activation_plan "${merry_enabled}" "${merry_version}" "${merry_version_provided}" "${bootstrap_strategy}" "${dart_packages[@]}"
  validate_host

  if [[ ${command_name} == bootstrap ]]; then
    locate_path_sdk "${sdk_family}" "${sdk_version}"
    resolve_pub_cache "${sdk_family}"
    apply_path_persistence "${persistence_adapter}"
    run_project_bootstrap "${bootstrap_strategy}" "${resolved_project_dir}"
    printf 'Merry bootstrap completed: sdk=%s version=%s bootstrap=%s persist=%s\n' "${sdk_family}" "${RESOLVED_SDK_VERSION}" "${bootstrap_strategy}" "${persistence_adapter}"
    return 0
  fi

  resolve_and_install_sdk "${sdk_family}" "${sdk_version}"
  install_flutterfire_bundle "${firebase_tools_version}"
  resolve_pub_cache "${sdk_family}"
  activate_global_packages
  run_flutter_precache
  resolve_trunk_launcher "${resolved_project_dir}"
  apply_path_persistence "${persistence_adapter}"
  run_project_bootstrap "${bootstrap_strategy}" "${resolved_project_dir}"
  printf 'Merry setup completed: sdk=%s version=%s bootstrap=%s persist=%s\n' "${sdk_family}" "${RESOLVED_SDK_VERSION}" "${bootstrap_strategy}" "${persistence_adapter}"
}

main "$@"
